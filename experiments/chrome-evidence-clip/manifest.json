{
  "manifest_version": 3,
  "name": "AxonRelay Evidence Clip",
  "version": "0.1.0",
  "description": "Capture an explicit text selection as task-scoped AxonRelay evidence.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Capture Evidence Clip"
  }
}
