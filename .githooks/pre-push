#!/bin/bash
# Pre-push hook: force-push guard, secret guard, personal-information guard.
#
# Enable with:  git config core.hooksPath .githooks
#
# The two content guards inspect the commits this push would actually send -
# their diffs and their metadata (author, committer, subject, body) - and refuse
# the push on a match. They split by what the pattern is:
#
#   Secrets       generic, worth committing, so they live in this file and work
#                 for everyone with no setup.
#   Personal info specific to whoever is pushing, so it lives in a local
#                 denylist that is never committed.
#
# Either guard can be bypassed for one push:
#
#   PUSH_GUARD_ALLOW=1 git push ...
#
# which is recorded on stderr. Read-only git commands are untouched.

remote_name="$1"

# ---------------------------------------------------------------------------
# 1. Force push to main
# ---------------------------------------------------------------------------

protected_branch="main"
current_branch=$(git symbolic-ref HEAD | sed -e 's,.*/\(.*\),\1,')

# Check if pushing to protected branch with force
push_command=$(ps -ocommand= -p $PPID)

if [[ "$current_branch" == "$protected_branch" ]] && [[ "$push_command" == *"--force"* || "$push_command" == *"-f"* ]]; then
    echo "=========================================="
    echo "ERROR: Force push to '$protected_branch' is not allowed!"
    echo "=========================================="
    echo ""
    echo "If you need to undo changes, use:"
    echo "  git revert HEAD"
    echo "  git push origin main"
    echo ""
    exit 1
fi

# Check if pushing directly to main (warn only, allow for now)
if [[ "$current_branch" == "$protected_branch" ]]; then
    echo "WARNING: Pushing directly to '$protected_branch'."
    echo "Consider using a feature branch and Pull Request instead."
    echo ""
fi

# ---------------------------------------------------------------------------
# 2. Secrets - built in, always on
# ---------------------------------------------------------------------------
#
# Credential shapes, not values: a provider's key format is public knowledge,
# so these patterns are safe to commit and useful to everyone who clones this.
#
# Keep them anchored on a format that is hard to produce by accident. A pattern
# loose enough to fire on ordinary code trains people to reach for the bypass,
# which is worse than not having the guard.

secret_patterns='sk-ant-[A-Za-z0-9_-]{20,}
sk-proj-[A-Za-z0-9_-]{20,}
sk-[A-Za-z0-9]{32,}
lsv2_(pt|sk)_[A-Za-z0-9]{20,}
gh[pousr]_[A-Za-z0-9]{30,}
github_pat_[A-Za-z0-9_]{50,}
AKIA[0-9A-Z]{16}
ASIA[0-9A-Z]{16}
AIza[0-9A-Za-z_-]{35}
xox[baprs]-[A-Za-z0-9-]{10,}
glpat-[A-Za-z0-9_-]{20,}
dckr_pat_[A-Za-z0-9_-]{20,}
[MNO][A-Za-z0-9_-]{23}\.[A-Za-z0-9_-]{6}\.[A-Za-z0-9_-]{27}
-----BEGIN [A-Z ]*PRIVATE KEY-----
(password|passwd|secret|token|api[_-]?key)[[:space:]]*[:=][[:space:]]*.?[A-Za-z0-9/+_=-]{16,}
://[^/[:space:]]+:[^@/[:space:]]{8,}@'

# Placeholders and this repository's documented development defaults. Without
# these the guard fires on .env.example and on the deployment guides, which is
# how a guard gets turned off for good.
secret_exceptions='REPLACE_WITH
your-[a-z-]*
YOUR_[A-Z_]*
example\.com
axonrelay_dev
changeme
placeholder
<[A-Za-z_-]+>
\$\{[A-Za-z_]+
xxx+
XXX+
\.\.\.'

# ---------------------------------------------------------------------------
# 3. Personal information - local denylist
# ---------------------------------------------------------------------------
#
# A denylist of personal information has to spell out the very strings it
# protects, so committing it would publish what it guards. It lives outside the
# repository instead, and one copy covers every clone on the machine. Looked up
# in order:
#
#   $PUSH_DENYLIST_FILE                     explicit path
#   ~/.config/axonrelay/push-denylist.txt   default
#   .githooks/denylist.local                per-clone override (gitignored)
#
# Format: one extended regular expression per line. Blank lines and lines
# starting with # are ignored. A line starting with ! is an exception: a hit
# that also matches an exception is not reported, which is what makes broad
# patterns usable ("any email address" minus the few that are meant to be
# public).
#
# No denylist -> this guard is skipped, so a contributor who has not set one up
# is never blocked; the secret guard above still runs. A denylist that exists
# but yields no usable pattern -> the push is refused, because a misconfigured
# guard must not be indistinguishable from a passing one.

denylist=""
for candidate in \
    "$PUSH_DENYLIST_FILE" \
    "$HOME/.config/axonrelay/push-denylist.txt" \
    "$(git rev-parse --show-toplevel 2>/dev/null)/.githooks/denylist.local"
do
    [[ -n "$candidate" && -e "$candidate" ]] || continue
    denylist="$candidate"
    break
done

personal_patterns=""
personal_exceptions=""

if [[ -n "$denylist" ]]; then
    if [[ ! -r "$denylist" ]]; then
        echo "ERROR: denylist exists but cannot be read: $denylist" >&2
        echo "       Fix its permissions, or delete it to disable that guard." >&2
        exit 1
    fi

    personal_patterns=$(grep -vE '^[[:space:]]*(#|!|$)' "$denylist")
    personal_exceptions=$(sed -n 's/^[[:space:]]*!//p' "$denylist" | grep -vE '^[[:space:]]*$')

    if [[ -z "$personal_patterns" ]]; then
        echo "ERROR: denylist has no usable pattern: $denylist" >&2
        echo "       Add patterns, or delete the file to disable that guard." >&2
        exit 1
    fi
fi

# ---------------------------------------------------------------------------
# Scan
# ---------------------------------------------------------------------------

if [[ "$PUSH_GUARD_ALLOW" == "1" ]]; then
    echo "WARNING: push content guards bypassed (PUSH_GUARD_ALLOW=1)." >&2
    exit 0
fi

# Prints matching lines for one <patterns, exceptions> pair, or nothing.
#
# What gets scanned: commit metadata, and *added* lines only. Removed and
# context lines are skipped on purpose - a commit that deletes a leaked string
# necessarily contains that string in its diff, and blocking the fix is how a
# guard gets bypassed. Anything a range actually introduces still shows up as
# an added line in whichever commit introduced it.
#
# The leading '+' is stripped before matching, so a diff marker cannot stand in
# for the local part of an address ('+@app.get(...)' is a Python decorator, not
# an email).
scan_range() {
    local patterns="$1" exceptions="$2"
    shift 2

    {
        git log --format='commit %H%n%an <%ae>%n%cn <%ce>%n%s%n%b' --no-color "$@" 2>/dev/null
        git log -p --format='' --no-color "$@" 2>/dev/null \
            | grep -E '^\+' \
            | grep -vE '^\+\+\+' \
            | cut -c2-
    } \
        | grep -E -f <(printf '%s\n' "$patterns") \
        | { if [[ -n "$exceptions" ]]; then grep -v -E -f <(printf '%s\n' "$exceptions"); else cat; fi; } \
        | cut -c1-160 \
        | sort -u \
        | head -20
}

report() {
    local kind="$1" where="$2" hits="$3"
    echo "" >&2
    echo "==========================================" >&2
    echo "ERROR: $kind in what you are pushing" >&2
    echo "==========================================" >&2
    echo "range: $where" >&2
    echo "" >&2
    echo "$hits" | sed 's/^/  /' >&2
    echo "" >&2
}

zero="0000000000000000000000000000000000000000"
blocked=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
    # Deleting a ref sends no content to inspect.
    [[ "$local_sha" == "$zero" ]] && continue

    if [[ "$remote_sha" == "$zero" ]]; then
        # New branch: everything not already on the remote.
        range=("$local_sha" --not --remotes="$remote_name")
    else
        range=("$remote_sha..$local_sha")
    fi

    hits=$(scan_range "$secret_patterns" "$secret_exceptions" "${range[@]}")
    if [[ -n "$hits" ]]; then
        blocked=1
        report "a credential" "${range[*]}" "$hits"
    fi

    if [[ -n "$personal_patterns" ]]; then
        hits=$(scan_range "$personal_patterns" "$personal_exceptions" "${range[@]}")
        if [[ -n "$hits" ]]; then
            blocked=1
            report "personal information" "${range[*]}" "$hits"
        fi
    fi
done

if [[ "$blocked" == "1" ]]; then
    echo "Rewrite or amend the commits so these strings never reach the remote." >&2
    echo "A credential that was ever committed must be rotated, not just removed." >&2
    echo "To push anyway: PUSH_GUARD_ALLOW=1 git push ..." >&2
    echo "" >&2
    exit 1
fi

exit 0
