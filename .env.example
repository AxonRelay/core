# Caddy site address
# Local: :80 (default, plain HTTP)
# Production: yourdomain.com (auto HTTPS via Let's Encrypt)
CADDY_SITE_ADDRESS=:80

# OpenAI API Key (required for LLM features)
OPENAI_API_KEY=

# Redis (default works with docker-compose)
REDIS_URL=redis://redis:6379

# PostgreSQL Database
POSTGRES_DB=axonrelay
POSTGRES_USER=axonrelay
POSTGRES_PASSWORD=axonrelay_dev
DATABASE_URL=postgresql://axonrelay:axonrelay_dev@postgres:5432/axonrelay
