# =============================================================================
# AxonRelay (personal PoC) — Environment variables
# =============================================================================

# ---- PostgreSQL ----
POSTGRES_DB=axonrelay
POSTGRES_USER=axonrelay
POSTGRES_PASSWORD=axonrelay_dev
# As seen from the host (alembic, the MCP server). Containers get their own
# URL from docker-compose.yml, so leave the hostname as localhost here.
DATABASE_URL=postgresql://axonrelay:axonrelay_dev@localhost:5432/axonrelay

# Address the backend's published port binds to. Loopback by default; set it
# to this host's Tailscale address (100.x.y.z) when other devices need the REST
# API. Never 0.0.0.0 - the API has no per-caller authentication.
BACKEND_BIND_ADDR=127.0.0.1

# Optional. When set, the MCP server's --http transport requires
# `Authorization: Bearer <this value>` on every request (ADR-008). Leave it
# empty for stdio, or when the port is only reachable inside a tailnet.
AXONRELAY_MCP_TOKEN=

# Set to 1 only when the REST API is reachable solely through a proxy you
# control (Cloudflare Tunnel). The rate limiter then keys on the first
# X-Forwarded-For hop instead of the tunnel's own address. Leave unset for
# direct or Tailscale access, where the header could be forged.
AXONRELAY_TRUST_PROXY=

# Optional. Set to 1 to run this instance content-blind (ADR-010): every
# surface that accepts free text (task / draft / approval / agent / coordination
# writes) refuses, and the only write path is the Safe Envelope
# (POST /envelopes, ingest_safe_envelope) - opaque identifiers, enums, a
# source-produced artifact commitment and timestamps. Leave unset for the
# full-text local PoC.
AXONRELAY_SAFE_MODE=

# Optional, only meaningful with the envelope. Set to 1 to accept envelopes
# whose identifier_policy is "public" (owner/repo slugs); otherwise every
# identifier must be an opaque token.
AXONRELAY_SAFE_PUBLIC_IDENTIFIERS=

# Optional. Set to 1 to require a per-caller credential on every HTTP call -
# REST and the Streamable HTTP MCP transport (ADR-011). Issue one with
# `python -m app.credentials issue --actor self --scopes ledger:read,...`.
# Unset, every call runs as the operator (the loopback trust assumption);
# stdio is loopback either way.
AXONRELAY_REQUIRE_AUTH=

# Optional. A key (32+ bytes) for the sealed `requestState` handle that carries
# a half-finished interactive approval on MCP 2026-07-28 (ADR-013). Set it to
# resume a decision across a restart or across Streamable HTTP workers; unset,
# the key is process-local and a restart makes the client ask again. A weak
# value is refused at startup. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AXONRELAY_REQUEST_STATE_KEY=

# Coordination metadata ages out with `python -m app.retention` (ADR-012).
# There is no automatic sweep and no variable for it: run it by hand or from
# cron once you have seen `--dry-run` agree with you.

# ---- LangGraph Platform (Phase 2.2) ----
LANGGRAPH_API_URL=
LANGGRAPH_API_KEY=
LANGGRAPH_ASSISTANT_ID=axonrelay

# ---- LLM provider (used by axonrelay-graph deployed on Platform) ----
# These typically live in Platform secrets, but mirrored here for local
# `langgraph dev` testing.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
WRITER_MODEL=claude-sonnet-4-6
REVIEWER_MODEL=claude-haiku-4-5-20251001
# Only if LLM_PROVIDER=openai:
OPENAI_API_KEY=

# ---- Discord notification + mobile approval (Phase 2.6) ----
# Filled in after following docs/discord-setup-guide.md
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_WEBHOOK_PENDING=
DISCORD_WEBHOOK_COMPLETED=
DISCORD_WEBHOOK_AUDIT=
