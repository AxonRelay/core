# =============================================================================
# AxonRelay (personal PoC) — Environment variables
# =============================================================================

# ---- PostgreSQL ----
POSTGRES_DB=axonrelay
POSTGRES_USER=axonrelay
POSTGRES_PASSWORD=axonrelay_dev
# As seen from the host (alembic, the MCP server). Containers get their own
# URL from docker-compose.yml, so leave the hostname as localhost here.
DATABASE_URL=postgresql://axonrelay:axonrelay_dev@localhost:5432/axonrelay

# Address the backend's published port binds to. Loopback by default; set it
# to this host's Tailscale address (100.x.y.z) when other devices need the REST
# API. Never 0.0.0.0 - the API has no per-caller authentication.
BACKEND_BIND_ADDR=127.0.0.1

# Optional. When set, the MCP server's --http transport requires
# `Authorization: Bearer <this value>` on every request (ADR-008). Leave it
# empty for stdio, or when the port is only reachable inside a tailnet.
AXONRELAY_MCP_TOKEN=

# ---- LangGraph Platform (Phase 2.2) ----
LANGGRAPH_API_URL=
LANGGRAPH_API_KEY=
LANGGRAPH_ASSISTANT_ID=axonrelay

# ---- LLM provider (used by axonrelay-graph deployed on Platform) ----
# These typically live in Platform secrets, but mirrored here for local
# `langgraph dev` testing.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
WRITER_MODEL=claude-sonnet-4-6
REVIEWER_MODEL=claude-haiku-4-5-20251001
# Only if LLM_PROVIDER=openai:
OPENAI_API_KEY=

# ---- Discord notification + mobile approval (Phase 2.6) ----
# Filled in after following docs/discord-setup-guide.md
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_WEBHOOK_PENDING=
DISCORD_WEBHOOK_COMPLETED=
DISCORD_WEBHOOK_AUDIT=
